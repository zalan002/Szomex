# Production domain, without trailing slash
SITE_URL=https://tolgyalapanyag.hu
# E-mail: Mailgun HTTP API, EU region. Only a domain sending key belongs here, never the admin key.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.traininghungary.com
MAILGUN_API_BASE=https://api.eu.mailgun.net/v3
# Recipient of the form emails (default when empty: Szomex Kft. <info@szomex.hu>). Preview/Development: the tester's own address.
LEAD_TO=Szomex Kft. <info@szomex.hu>
# Hidden copy of every incoming enquiry (comma separated). Production only.
LEAD_BCC=
# Airtable output next to the e-mail (like the FIT site). Production only; leave empty elsewhere so tests do not land in the lead table.
# Table setup: node scripts/setup-airtable.mjs (creates/completes the "Érdeklődők" table, never deletes data).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appDbk2eNI5wi7FvR
AIRTABLE_TABLE_ID=tbldUvXLafkythnJM
# Optional sender; must be on the Mailgun domain. Default: Tölgy Alapanyag weboldal <noreply@MAILGUN_DOMAIN>
LEAD_FROM=
# Optional bot protection. Enforced only when BOTH keys are set; the public site key is included during build.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Existing public measurement IDs (same as the original tolgyalapanyag.hu)
PUBLIC_GA_ID=G-5W1XXG6H15
PUBLIC_GOOGLE_ADS_ID=AW-16959665415
PUBLIC_GTM_ID=GTM-T2Z9LF8Z
# Keep the legacy GTM disabled: its tags are reproduced directly, loading it too would double count.
PUBLIC_ENABLE_LEGACY_GTM=false
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=rf8y3ss130
# Conversion action label of the original /koszonooldal conversion.
PUBLIC_GOOGLE_ADS_LEAD_LABEL=wGcRCIuopNIaEIfq_5Y_
# Only production builds can enable measurement; previews always stay disabled.
PUBLIC_ENABLE_TRACKING=false
