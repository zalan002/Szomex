# Production domain, without trailing slash
SITE_URL=https://tolgyalapanyag.hu
# Required: authenticated sending domain with Resend. Never use the visitor as From.
RESEND_API_KEY=
LEAD_FROM=
LEAD_TO=taborfalva@szomex.hu
# Production forms require Turnstile; public site key is included during build.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Existing public measurement IDs (retained from original page)
PUBLIC_GA_ID=G-5W1XXG6H15
PUBLIC_GOOGLE_ADS_ID=AW-16959665415
PUBLIC_GTM_ID=GTM-T2Z9LF8Z
# Keep the legacy GTM disabled until its container is audited for duplicate tags.
PUBLIC_ENABLE_LEGACY_GTM=false
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=rf8y3ss130
# Requires a real conversion action label from Google Ads, not just the AW ID.
PUBLIC_GOOGLE_ADS_LEAD_LABEL=wGcRCIuopNIaEIfq_5Y_
# Preview builds disable measurement by default. Production enable after verification.
PUBLIC_ENABLE_TRACKING=false
